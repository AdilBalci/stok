# ==========================================
# GOOGLE CLOUD & N8N DEPLOYMENT
# ==========================================

# Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Google Cloud Region
REGION=us-central1

# Service Name
SERVICE_NAME=n8n-stok-yonetim

# ==========================================
# DATABASE (Cloud SQL PostgreSQL)
# ==========================================

# Database Instance Name
DB_INSTANCE_NAME=n8n-database

# Database Name
DB_NAME=n8n

# Database User
DB_USER=n8n_user

# Database Password (CHANGE THIS!)
DB_PASSWORD=YourSecurePasswordHere123!

# Database Host (auto-filled by deployment script)
DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Database Port
DB_PORT=5432

# ==========================================
# N8N CONFIGURATION
# ==========================================

# N8n Basic Auth Username
N8N_BASIC_AUTH_USER=admin

# N8n Basic Auth Password (CHANGE THIS!)
N8N_BASIC_AUTH_PASSWORD=YourSecureN8nPasswordHere123!

# N8n Encryption Key (CHANGE THIS! Use a strong random key)
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Webhook URL (will be auto-generated after deployment)
WEBHOOK_URL=https://n8n-stok-yonetim-PROJECT_ID.a.run.app

# ==========================================
# JWT CONFIGURATION
# ==========================================

# JWT Secret Key (CHANGE THIS! Use a strong random key)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-minimum-32-characters

# ==========================================
# OPENAI API
# ==========================================

# OpenAI API Key
OPENAI_API_KEY=sk-...your-openai-api-key

# OpenAI Model (for cost optimization)
OPENAI_MODEL=gpt-3.5-turbo

# ==========================================
# GOOGLE SHEETS
# ==========================================

# Google Sheets Document ID
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Sheet Name
GOOGLE_SHEET_NAME=Stok

# ==========================================
# ŞUBE PIN'LERİ (Production'da DB'de saklanmalı)
# ==========================================

PIN_MERKEZ=123456
PIN_KADIKOY=234567
PIN_BESIKTAS=345678
PIN_SISLI=456789
PIN_USKUDAR=567890
PIN_BAKIRKOY=678901

# ==========================================
# FRONTEND (PWA) DEPLOYMENT
# ==========================================

# Vercel veya diğer hosting için
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n-stok-yonetim-PROJECT_ID.a.run.app/webhook/ses-kayit
NEXT_PUBLIC_LOGIN_WEBHOOK_URL=https://n8n-stok-yonetim-PROJECT_ID.a.run.app/webhook/login

# ==========================================
# OPTIONAL: MONITORING & LOGGING
# ==========================================

# Sentry DSN (optional)
SENTRY_DSN=

# Log Level
LOG_LEVEL=info

# ==========================================
# OPTIONAL: CLAUDE API (for alternative LLM)
# ==========================================

# Claude API Key (if using Anthropic instead of OpenAI)
CLAUDE_API_KEY=

# ==========================================
# OPTIONAL: GOOGLE STUDIO API
# ==========================================

# Google Studio API Key (if using Gemini)
GOOGLE_STUDIO_API_KEY=

# ==========================================
# NOTLAR
# ==========================================

# 1. Tüm "CHANGE THIS!" işaretli değerleri mutlaka değiştirin
# 2. API key'leri asla Git'e commit etmeyin
# 3. Production'da .env dosyasını .gitignore'a ekleyin
# 4. Güçlü şifreler oluşturmak için: https://passwordsgenerator.net/
# 5. JWT ve Encryption key'ler en az 32 karakter olmalı
